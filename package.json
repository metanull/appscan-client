{
  "name": "@metanull/appscan-client",
  "version": "1.2.1",
  "description": "Utility to work with HCL AppScan Cloud API",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "appscan": "./src/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "generate-api": "node scripts/generate-api-client.js",
    "prepublishOnly": "npm run generate-api && npm test"
  },
  "keywords": [
    "appscan",
    "security",
    "cli",
    "hcl"
  ],
  "author": "metanull",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metanull/appscan-client.git"
  },
  "bugs": {
    "url": "https://github.com/metanull/appscan-client/issues"
  },
  "homepage": "https://github.com/metanull/appscan-client#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "marked": "^17.0.1",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0"
  },
  "optionalDependencies": {
    "jira.js": "^5.2.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.2.1",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "swagger-typescript-api": "^13.2.16"
  }
}

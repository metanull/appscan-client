{
  "name": "@metanull/appscan-client",
  "version": "5.1.0",
  "description": "Utility to work with HCL AppScan Cloud API",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "appscan": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "lint": "eslint src tests lab",
    "lint:fix": "eslint src tests lab --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.{js,jsx}\" \"lab/**/*.{js,jsx}\"",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "generate-api": "node scripts/generate-api-client.js",
    "generate-api:download": "node scripts/generate-api-client.js --download"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "appscan",
    "security",
    "cli",
    "tui",
    "hcl",
    "ink"
  ],
  "author": "Pascal (MetaNull) Havelange",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metanull/appscan-client.git"
  },
  "bugs": {
    "url": "https://github.com/metanull/appscan-client/issues"
  },
  "homepage": "https://github.com/metanull/appscan-client#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "axios": "^1.13.2",
    "azure-devops-node-api": "^15.1.2",
    "chalk": "^5.6.2",
    "cli-markdown": "^3.5.1",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ink": "^6.5.1",
    "ink-link": "^5.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ink-use-stdout-dimensions": "^1.0.5",
    "marked": "^17.0.1",
    "meow": "^14.0.0",
    "node-html-parser": "^7.0.1",
    "open": "^11.0.0",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0",
    "zustand": "^5.0.2"
  },
  "optionalDependencies": {
    "jira.js": "^5.2.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.7.4",
    "swagger-typescript-api": "^13.2.16",
    "vitest": "^4.0.16"
  }
}

{
  "name": "@metanull/appscan-client",
  "version": "2.0.0",
  "description": "Utility to work with HCL AppScan Cloud API",
  "type": "module",
  "bin": {
    "appscan": "./dist/index.js"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && node dist/index.js",
    "triage": "npm run build && node dist/index.js triage",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "generate-api": "node scripts/generate-api-client.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run generate-api && npm test && npm run build"
  },
  "keywords": [
    "appscan",
    "security",
    "cli",
    "hcl"
  ],
  "author": "metanull",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metanull/appscan-client.git"
  },
  "bugs": {
    "url": "https://github.com/metanull/appscan-client/issues"
  },
  "homepage": "https://github.com/metanull/appscan-client#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "cli-markdown": "^3.5.1",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "ink-link": "^4.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ink-use-stdout-dimensions": "^1.0.5",
    "marked": "^17.0.1",
    "meow": "^14.0.0",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "ink": "^6.5.1",
    "react": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "jira.js": "^5.2.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-react": "^7.37.5",
    "ink": "^6.5.1",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "swagger-typescript-api": "^13.2.16",
    "zustand": "^5.0.2"
  }
}

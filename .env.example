# AppScan API Configuration
APPSCAN_API_KEY=your_api_key_here
APPSCAN_API_SECRET=your_api_secret_here
APPSCAN_BASE_URL=https://cloud.appscan.com

# Jira Configuration
JIRA_HOST=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=PROJ

# Azure DevOps Configuration
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_BASE_URL=https://dev.azure.com
# Azure DevOps Personal Access Token
# Generate at: https://dev.azure.com/{organization}/_usersSettings/tokens
# Required scopes: Build (read), Release (read), Code (read)
# Never commit this to version control
AZURE_DEVOPS_PAT="your_azure_devops_pat_here"

# Azure DevOps Organization Name
# Example: "MyCompany", "EESC-CoR", etc.
# Found at: https://dev.azure.com/{ORGANIZATION}
AZURE_DEVOPS_ORG="your-organization"

# Confluence Configuration
CONFLUENCE_HOST=https://your-domain.atlassian.net

# HTTP Proxy Configuration (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.local
# For self-signed proxy certificates (Unsafe, prefer using PROXY_CA_CERT):
# PROXY_REJECT_UNAUTHORIZED=false
# Custom CA certificate bundle (add custom CA CERT to the global NODE_EXTRA_CA_CERTS):
# PROXY_CA_CERT=/path/to/ca-bundle.crt
